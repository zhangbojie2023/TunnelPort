{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunnelPort",
  "version": "0.1.0",
  "identifier": "com.zhangbojie.tunnelport",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TunnelPort",
        "width": 420,
        "height": 520,
        "resizable": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 13 },
        "hiddenTitle": true,
        "transparent": true,
        "backgroundColor": "#f4f2ee"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
